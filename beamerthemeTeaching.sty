% beamerthemeTeaching.sty
% A lightweight Beamer theme for university mathematics teaching.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeTeaching}[2026/08/26 v0.5 Teaching Beamer theme]

\mode<presentation>

% Beamer already loads xcolor, amsthm and translator.  Only the AMS
% mathematical packages used by the teaching documents are requested here.
\RequirePackage{amsmath}
\RequirePackage{amssymb}

% --------------------------------------------------------------------------
% Options
% --------------------------------------------------------------------------
\newif\ifTeaching@sectionpages
\Teaching@sectionpagestrue

\DeclareOptionBeamer{sectionpages}{\Teaching@sectionpagestrue}
\DeclareOptionBeamer{nosectionpages}{\Teaching@sectionpagesfalse}
\ProcessOptionsBeamer

% --------------------------------------------------------------------------
% Palette
% --------------------------------------------------------------------------
% PANTONE 123 CVC (yellow) and PANTONE 201 CVC (red).  The RGB values are
% those specified for the institutional palette in the current US digital
% identity manual.
\definecolor{USPantoneOneTwoThree}{RGB}{250,186,9}
\definecolor{USPantoneTwoZeroOne}{RGB}{165,1,51}
\definecolor{TeachingBlack}{RGB}{0,0,0}

\setbeamercolor{normal text}{fg=TeachingBlack,bg=white}
\setbeamercolor{structure}{fg=USPantoneTwoZeroOne}
\setbeamercolor{alerted text}{fg=USPantoneTwoZeroOne}
\setbeamercolor{title}{fg=USPantoneTwoZeroOne}
\setbeamercolor{subtitle}{fg=TeachingBlack}
\setbeamercolor{author}{fg=TeachingBlack}
\setbeamercolor{institute}{fg=TeachingBlack}
\setbeamercolor{date}{fg=TeachingBlack}
\setbeamercolor{frametitle}{fg=USPantoneTwoZeroOne,bg=white}
\setbeamercolor{framesubtitle}{fg=TeachingBlack,bg=white}
\setbeamercolor{frame rule}{bg=USPantoneOneTwoThree}
\setbeamercolor{section title}{fg=white,bg=USPantoneTwoZeroOne}

% Mathematical environments retain the standard AMS distinction: plain
% theorems are italic, while definitions, examples and proofs are upright.
% Colour is restricted to their titles; the bodies have no coloured ground.
\setbeamercolor{block title}{fg=USPantoneTwoZeroOne,bg=white}
\setbeamercolor{block body}{fg=TeachingBlack,bg=white}
\setbeamercolor{block title alerted}{fg=USPantoneTwoZeroOne,bg=white}
\setbeamercolor{block body alerted}{fg=TeachingBlack,bg=white}
\setbeamercolor{block title example}{fg=USPantoneTwoZeroOne,bg=white}
\setbeamercolor{block body example}{fg=TeachingBlack,bg=white}

% --------------------------------------------------------------------------
% Typography and lists
% --------------------------------------------------------------------------
% Standard LaTeX roman fonts for text and mathematics: no external font
% package is required.
\usefonttheme{serif}
\setbeamerfont{title}{series=\bfseries,size=\LARGE}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{frametitle}{series=\bfseries,size=\large}
\setbeamerfont{framesubtitle}{series=\mdseries,size=\small}
\setbeamerfont{block title}{series=\bfseries}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{items}[circle]
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{blocks}[default]
\setbeamertemplate{footline}{}
\setbeamersize{text margin left=8mm,text margin right=8mm}

% Beamer's default proof template is a block and therefore an indivisible
% box.  This unboxed template keeps the same visual hierarchy while allowing
% `allowframebreaks` to split a proof (and the proof-based `solution`
% environment below) between slides.  AMS places the QED symbol at the end of
% the vertical material, so it appears only on the final slide.
\setbeamertemplate{proof begin}{%
  \par\medskip
  {\noindent
    \usebeamerfont{block title}%
    \usebeamercolor[fg]{block title}%
    \insertproofname\par}%
  \smallskip
}
\setbeamertemplate{proof end}{\par\medskip}
\setbeamertemplate{qed symbol}{%
  \usebeamercolor[fg]{structure}\openbox}

% Use the US logo supplied with the theme as the default title graphic.  The
% resolved path is stored so that compilation works both from the repository
% root and from examples/.  A later \titlegraphic command can replace it.
\newcommand{\TeachingLogoFile}{}
\IfFileExists{assets/logo-us.png}{%
  \edef\TeachingLogoFile{\@filef@und}%
}{}
\ifx\TeachingLogoFile\@empty\else
  \titlegraphic{%
    \includegraphics[width=0.20\paperwidth]{\TeachingLogoFile}}
\fi

% --------------------------------------------------------------------------
% Title page and frame titles
% --------------------------------------------------------------------------
\setbeamertemplate{title page}{%
  \vbox{}
  \vfill
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=8mm,rightskip=12mm,sep=0pt]{title}
    \begin{minipage}[c]{0.66\paperwidth}
      {\usebeamerfont{title}\inserttitle\par}
      \ifx\insertsubtitle\@empty\else
        \vskip0.55em
        {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
      \fi
      \vskip0.8em
      {\color{USPantoneOneTwoThree}\rule{0.23\paperwidth}{1.4pt}\par}
      \vskip1.1em
      {\usebeamerfont{author}\insertauthor\par}
      \vskip0.25em
      {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}
      \vskip0.65em
      {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}
    \end{minipage}%
    \ifx\inserttitlegraphic\@empty\else
      \hfill
      \begin{minipage}[c]{0.20\paperwidth}
        \centering
        \inserttitlegraphic
      \end{minipage}%
    \fi
  \end{beamercolorbox}
  \vfill
}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[
      wd=\paperwidth,
      leftskip=8mm,
      rightskip=8mm,
      sep=0.24cm
    ]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\strut
    \ifx\insertframesubtitle\@empty\else
      \par\usebeamerfont{framesubtitle}\insertframesubtitle\strut
    \fi
  \end{beamercolorbox}
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.7pt,dp=0pt]{frame rule}
  \end{beamercolorbox}
}

% --------------------------------------------------------------------------
% Section divider
% --------------------------------------------------------------------------
\ifTeaching@sectionpages
  \AtBeginSection[]{%
    \begingroup
      \setbeamercolor{background canvas}{bg=USPantoneTwoZeroOne}
      \begin{frame}[plain,noframenumbering]
        \vfill
        \centering
        {\usebeamerfont{title}\usebeamercolor[fg]{section title}%
          \insertsectionhead\par}
        \vfill
      \end{frame}
    \endgroup
  }
\fi

% --------------------------------------------------------------------------
% Mathematical environments: Spanish is the first supported language.
% Beamer supplies theorem, lemma, corollary, definition, example and proof.
% --------------------------------------------------------------------------
\uselanguage{Spanish}
\languagepath{Spanish}
\deftranslation[to=Spanish]{Theorem}{Teorema}
\deftranslation[to=Spanish]{Lemma}{Lema}
\deftranslation[to=Spanish]{Corollary}{Corolario}
\deftranslation[to=Spanish]{Definition}{Definición}
\deftranslation[to=Spanish]{Definitions}{Definiciones}
\deftranslation[to=Spanish]{Example}{Ejemplo}
\deftranslation[to=Spanish]{Examples}{Ejemplos}
\deftranslation[to=Spanish]{Proof}{Demostración}
\deftranslation[to=Spanish]{Exercise}{Ejercicio}
\deftranslation[to=Spanish]{Solution}{Solución}
\deftranslation[to=Spanish]{Continuation}{continuación}

\theoremstyle{plain}
\newtheorem{proposition}[theorem]{Proposición}

\theoremstyle{definition}
\newtheorem{exercise}[theorem]{\translate{Exercise}}

% Beamer defines `solution` as a theorem with italic body.  For teaching
% slides it is more natural to typeset it like a proof, in upright text and
% with a closing symbol.
\renewenvironment{solution}[1][\translate{Solution}]
  {\begin{proof}[#1]}
  {\end{proof}}

% Manual segmentation remains available when independently designed frames
% are preferable to an automatically broken frame.  Non-final segments omit
% the QED symbol; the final one uses the ordinary `proof` or `solution`.
\newenvironment{proofpart}[1][\translate{Proof}]
  {\begingroup\renewcommand{\qedsymbol}{}\begin{proof}[#1]}
  {\end{proof}\endgroup}

\newenvironment{solutionpart}[1][\translate{Solution}]
  {\begingroup\renewcommand{\qedsymbol}{}\begin{proof}[#1]}
  {\end{proof}\endgroup}

\newcommand{\proofcontinuationname}{%
  \translate{Proof}~(\translate{Continuation})}
\newcommand{\solutioncontinuationname}{%
  \translate{Solution}~(\translate{Continuation})}

% Do not alter the theorem style selected by users after loading the theme.
\theoremstyle{plain}

\mode<all>

\endinput
